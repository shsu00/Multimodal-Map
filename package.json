{
  "name": "multimodal-router",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "web": "npm run dev -w apps/web",
    "mobile": "npm run start -w apps/mobile",
    "planner": "cd services/planner && .venv/bin/uvicorn planner.main:app --reload --port 8000",
    "planner:fake": "cd services/planner && PLANNER_FAKE_ROUTER=1 .venv/bin/uvicorn planner.main:app --reload --port 8000",
    "otp": "scripts/otp.sh seattle serve",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
